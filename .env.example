# Copy to .env.local for local dev; set the same in Vercel project env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Provided by Vercel Postgres + Vercel KV (via `vercel env pull .env.local`):
# POSTGRES_URL=...
# KV_REST_API_URL=...
# KV_REST_API_TOKEN=...

# Ingestion
CONTENT_DIR=./content

# Enquiry form and admin authentication:
ADMIN_SECRET=              # Fallback: single shared Bearer token for /api/admin (legacy)
# Per-user admin keys for /api/enquiry-admin (preferred — set ADMIN_USERS instead of ADMIN_SECRET):
# ADMIN_USERS=[{"name":"dan","key":"<openssl rand -hex 32>","role":"admin"},{"name":"reception","key":"<key>","role":"viewer"}]
# Roles: admin = GET + PATCH queue override | viewer = GET only
ENQUIRY_FORM_V2=0          # Set to 1 to enable guided multi-step enquiry form (requires rebuild)
FORMSPREE_ENDPOINT=        # Formspree form URL — https://formspree.io/f/mnpjbroe (required in Production; hardcoded fallback active until set)
AGENT_INTAKE_TOKEN=        # Bearer token for GET /api/agent-intake (GrokBot bridge). Generate: openssl rand -hex 32
